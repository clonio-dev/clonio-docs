{
    "name": "clonio-dev/clonio-docs",
    "description": "Static Clonio documentation site generated with Laravel Pergament.",
    "type": "project",
    "require": {
        "php": "^8.5",
        "rokde/laravel-pergament": "^1.5.3",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ]
    },
    "scripts": {
        "build": "vendor/bin/pergament generate-static public --content-path=content --base-url=\"https://clonio.dev\" --clean",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "APP_URL=http://localhost:2566 vendor/bin/pergament generate-static public --content-path=content --base-url=\"http://localhost:2566\" --clean",
            "php -S localhost:2566 -t public"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
